NEXT_PUBLIC_API_BASE_URL=https://kajolaplus-api-v1.onrender.com

# Cooperative/admin setup backend (e.g. /api/CooperativeAccount/*) — a
# separate deployment from the member-facing API above.
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://44.213.46.40:7296

# Google Cloud Console — OAuth client used for "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string NextAuth uses to encrypt its session. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# The URL NextAuth should build callback URLs against. Must match how you
# actually open the app in the browser (port must match `npm run dev`).
NEXTAUTH_URL=http://localhost:3000
